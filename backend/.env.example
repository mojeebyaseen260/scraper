# ── Copy this file to .env and fill in your values ──────────
# Never commit .env to git

# PostgreSQL connection string (Railway provides this automatically when you
# add a Postgres service). Format:
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/coldleads

# JWT secret — change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret-key-min-32-chars

# Set to 1 in production
PRODUCTION=0

# Comma-separated allowed origins (no spaces)
# Dev: http://localhost:3000,http://localhost:3001
# Prod: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Admin account created on first run
ADMIN_EMAIL=admin@coldleads.com
ADMIN_PASSWORD=Admin@123

# Browserless.io token (optional - if not set, uses local Chrome)
BROWSERLESS_TOKEN=

# Note: each user runs one job at a time; extra jobs are queued automatically.
