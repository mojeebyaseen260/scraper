# ── ColdLeads production .env — tuned for a KVM 4 VPS (4 vCPU / 16 GB RAM) ──
# Copy this to `.env` on the VPS and fill in the secrets at the bottom.
#
# IMPORTANT: With PRODUCTION=1 the app defaults to LEAN settings (slow, less
# data). The knobs below OVERRIDE those defaults to run fast + scrape more.

PRODUCTION=1

# ── Speed: parallel headless-Chrome scrapers ──
# 4 vCPU; scraping spends a lot of time waiting on Google, so 6 overcommits the
# cores a little for more throughput. 16 GB RAM holds 6 Chrome easily.
# If CPU stays pegged at 100%, drop to 4.
NUM_DRIVERS=7

# ── More data per query (thorough scrolling) ──
MAX_PLACES=500
SCROLL_ROUNDS=150
SCROLL_PAUSE=0.6
SCROLL_STALL_LIMIT=18

# ── More + faster emails ──
EMAIL_WORKERS=72
MAX_EMAIL_PAGES=10
EMAIL_DEEP=1
EMAIL_TIMEOUT=10
EMAIL_CRAWL_BUDGET=30

# ── Local SQLite (no external DB needed) ──
SQLITE_PATH=coldleads.db

# ── Secrets / access — EDIT THESE ──
# Generate a long random secret:  openssl rand -hex 32
JWT_SECRET=PUT_A_LONG_RANDOM_SECRET_HERE
# The browser origin you'll open. Replace YOUR_SERVER_IP (and port if changed).
ALLOWED_ORIGINS=http://YOUR_SERVER_IP:6002
# Seed admin account (created on first run if the DB is empty)
ADMIN_EMAIL=admin@coldleads.com
ADMIN_PASSWORD=CHANGE_ME_STRONG
